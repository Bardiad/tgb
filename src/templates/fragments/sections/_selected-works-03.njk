<section id="projects" class="c-posts u-bg-color-misc-white u-padding-b-1000 u-padding-b-1500-@xl">
	<div class="o-container u-text-align-center-@lg  u-margin-b-900-@xl u-margin-b-600-@xs">
		<h2 class="heading-1 u-margin-b-100 w-100">Selected works</h2>
		<p class="subheading-1 u-font-weight-400 u-color-ash-500">Some of the work I'm most proud</p>
	</div>
	<div class="o-fluid-width-container">


		<div>
		  {% for post in data.POSTS %}

		    {% if post.isLast %}
				<article class="c-banner c-banner--small c-banner--info">
					<h2 class="c-banner__heading subheading-1 u-text-align-left">Not everything’s here yet, but it’s on the way</h2>					
					<p class="c-banner__description u-text-align-left">More case studies are on the way, in the mean time you can see my work from 2015-2018 on the <a href="old/">previous version of my site</a>.</p>
				</article>		    	
		    {% else %}
			    <article class="c-post">
			    	{% if not post.comingSoon %}
						<a data-gtag-event="case_study_{{post.slug}}" href="/case-studies/{{ post.slug }}.html" class="u-block c-post__link-wrap">	
			    	{% endif %}
						{% if post.comingSoon %}
							<div class="c-post__cs-wrapper u-border-color-ash-200 u-block">
								<img src="{{ post.thumbnail }}" alt="thumbnail for {{ post.headinline }}" class="o-fluid-img c-post__thumbnail"/>
								<div class="c-post__thumbnail-overlay"></div>
								<p class="c-post__cs-label">Coming soon</p>
							</div>
						{% else %}
							<div class="c-post__thumbnail" style="--projTheme: {{ post.theme }}">
								<img src="{{ post.thumbnail }}" alt="thumbnail for {{ post.headinline }}" width="850" height="552" class="o-fluid-img c-post__thumbnail-img"/>
							</div>
						{% endif %}

						<div class="c-post__content">
							<p class="c-post__meta u-color-ash-800 u-margin-t-300-@xs u-margin-t-0-@xl">{{ post.year }}</p>				
							<h3 class="c-post__title subheading-1 u-margin-b-200">{{ post.headline }}</h3>

							{% if post.tags %}
							<ul class="c-taglist u-margin-b-500">
								{%  for tag in post.tags %}
									<li class="c-taglist__tag">{{ tag }}</li>
								{% endfor %}			        
							</ul>
							{% endif %}

				        	<p class="c-post__description body-copy u-color-ash-500">{{ post.description }}</p>				        	
				      	</div>
					{% if not post.comingSoon %}
						</a>
			    	{% endif %}			      	
			    </article>
		    {% endif %}

		  {% endfor %}
		</div>		
	</div>
</section>